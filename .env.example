# Example environment variables for local runs (do NOT commit secrets here)
# Copy to .env and fill with real values when needed

# Network: mainnet | testnet
NETWORK=mainnet

# Wallet file path (relative to repo root)
WALLET_FILE=wallets.json

# Limits for multi-wallet scripts
START_INDEX=0
WALLET_LIMIT=10
MINTS_PER_WALLET=1

# Override API endpoints if needed
# HIRO_API_URL=https://api.hiro.so
