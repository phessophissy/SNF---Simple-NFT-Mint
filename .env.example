# ── Stacks Network ──────────────────────────────────────────────
# Use "mainnet" or "testnet"
NETWORK=mainnet

# ── Funding Wallet (for bulk wallet funding scripts) ───────────
# NEVER store a real mnemonic here. This file is a template only.
# Copy to .env and fill in your own values.
FUNDER_MNEMONIC=your twenty four word mnemonic phrase here

# ── Funding Parameters ─────────────────────────────────────────
# Amount to send per wallet in STX
AMOUNT_STX=0.05
# Delay between transactions in ms
DELAY_MS=400
# Maximum wallets to fund per run
WALLET_LIMIT=50
# Starting wallet index
START_INDEX=0
# Transfer fee in microSTX
TRANSFER_FEE_MICROSTX=1000
